# Copy this file to `.env` and fill in your own values.
# `.env` itself is gitignored — never commit real secrets.

# Generate a fresh one for production: https://djecrety.ir/
SECRET_KEY=dev-insecure-secret-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email ---
# Console backend just prints emails to your terminal — perfect for dev.
# Switch to an SMTP backend + real credentials once you're ready to send
# real emails (Gmail, SendGrid, Mailgun, etc all work the same way).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Grey Academy <no-reply@greyacademy.test>

# --- Google OAuth (see README.md for the step-by-step walkthrough) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
